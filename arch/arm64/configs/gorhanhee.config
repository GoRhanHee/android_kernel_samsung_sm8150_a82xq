# Nuke Samsung anti-protection
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_RKP_MODULE_SUPPORT=n
CONFIG_RKP_KDP=n
CONFIG_RKP_NS_PROT=n
CONFIG_RKP_DMAP_PROT=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n

CONFIG_RKP_CFP=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_JOPP_MAGIC=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_RKP_CFP_ROPP_SnSREGKEn=n

CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_PROCA_S_OS=n

# Setting Kernel Localversion
CONFIG_LOCALVERSION="-GoRhanHee_Kernel"
CONFIG_LOCALVERSION_AUTO=n

# KernelSU-Next
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_KPROBES_HOOK=n